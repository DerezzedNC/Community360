              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('Mensaje del contrato', () => pm.expect(pm.response.json()).to.eql({ detail: 'Correo o contraseña incorrectos' }));",
                  "pm.test('No entrega token', () => pm.expect(pm.response.json()).to.not.have.property('token'));"
                ]
