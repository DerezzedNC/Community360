{
  "info": {
    "name": "COMMUNITY 360",
    "description": "Colección de la API. Contrato: docs/CONTRATO_API.md. Instrucciones: postman/README.md.\n\nUsa el entorno COMMUNITY 360. Las contraseñas van solo en el valor local del entorno.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Otro entorno podría pisar las variables o mandar datos a otro servidor",
          "if (pm.environment.name !== 'COMMUNITY 360') {",
          "    pm.test('Elige el entorno COMMUNITY 360 (arriba a la derecha).', () => pm.expect.fail('Petición no enviada'));",
          "    pm.execution.skipRequest();",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Fase 3 · Autenticación",
      "item": [
        {
          "name": "1. Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 o 503', () => pm.expect(pm.response.code).to.be.oneOf([200, 503]));",
                  "pm.test('El estado coincide con las bases', () => {",
                  "    const r = pm.response.json();",
                  "    const todoBien = r.tidb && r.capella;",
                  "    pm.expect(r.estado).to.eql(todoBien ? 'ok' : 'degradado');",
                  "    pm.expect(pm.response.code).to.eql(todoBien ? 200 : 503);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{c360_base_url}}/api/health",
              "host": [
                "{{c360_base_url}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Ruta pública. 200 si TiDB y Capella responden; 503 si falta alguna."
          },
          "response": []
        },
        {
