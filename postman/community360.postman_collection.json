        {
          "name": "7. Token revocado",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.environment.get('c360_token');",
                  "if (!token) {",
                  "    pm.test('Primero envía Login admin y Logout: c360_token está vacío.', () => pm.expect.fail('Petición no enviada'));",
                  "    pm.execution.skipRequest();",
                  "}",
                  "// Se lee cuándo vence para demostrar que el 401 no es por tiempo",
                  "const partes = token.split('.');",
                  "const datos = JSON.parse(atob(partes[1].replace(/-/g, '+').replace(/_/g, '/')));",
                  "pm.variables.set('c360_exp', datos.exp);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('Mensaje del contrato', () => pm.expect(pm.response.json()).to.eql({ detail: 'Sesión no válida o vencida' }));",
                  "pm.test('El token todavía no vence: el 401 es por el logout', () => {",
                  "    pm.expect(Number(pm.variables.get('c360_exp'))).to.be.above(Date.now() / 1000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{c360_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{c360_base_url}}/api/auth/me",
              "host": [
                "{{c360_base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Evidencia F3-09. El mismo token después del logout: 401 aunque no haya vencido."
          },
          "response": [],
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        },
