        {
          "name": "4. Login admin",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const correo = pm.environment.get('c360_correo_admin');",
                  "const password = pm.environment.get('c360_password_admin');",
                  "if (!correo || !password) {",
                  "    pm.test('Llena c360_correo_admin y c360_password_admin en el entorno COMMUNITY 360 (valor local).', () => pm.expect.fail('Petición no enviada'));",
                  "    pm.execution.skipRequest();",
                  "}",
                  "// Si el login falla, que no quede un token anterior",
                  "pm.environment.set('c360_token', '');",
                  "// JSON.stringify pone las comillas y protege caracteres como \" o \\",
                  "pm.variables.set('c360_correo_json', JSON.stringify(correo));",
                  "pm.variables.set('c360_password_json', JSON.stringify(password));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('Token y usuario con rol admin', () => {",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.tipo).to.eql('bearer');",
                  "    pm.expect(r.expira_en).to.eql(3600);",
                  "    pm.expect(r.token).to.be.a('string').and.not.empty;",
                  "    pm.expect(r.usuario).to.have.all.keys('id_admin', 'nombre', 'correo', 'rol');",
                  "    pm.expect(r.usuario.rol).to.eql('admin');",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.environment.set('c360_token', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
