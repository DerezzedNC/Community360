        {
          "name": "12. Catálogos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('Los 8 catálogos y nada de geografía', () => {",
                  "    pm.expect(r).to.have.all.keys('rango_edad', 'especie', 'interes', 'plataforma', 'tema', 'etiqueta', 'tipo_interaccion', 'dispositivo');",
                  "});",
                  "pm.test('Campos con el nombre de las columnas de TiDB', () => {",
                  "    Object.entries(r).forEach(([catalogo, lista]) => {",
                  "        const nombre = catalogo === 'rango_edad' ? 'descripcion' : 'nombre';",
                  "        const llaves = catalogo === 'tipo_interaccion' ? ['codigo', nombre, 'admite_texto', 'activo'] : ['codigo', nombre, 'activo'];",
                  "        lista.forEach(item => pm.expect(item, catalogo).to.have.all.keys(llaves));",
                  "    });",
                  "});",
                  "pm.test('Cada lista ordenada por código', () => {",
                  "    Object.entries(r).forEach(([catalogo, lista]) => {",
                  "        const codigos = lista.map(i => i.codigo);",
                  "        pm.expect(codigos, catalogo).to.eql([...codigos].sort());",
                  "    });",
                  "});"
                ]
              }
            }
          ],
