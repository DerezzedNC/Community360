                  "if (!correo) {",
                  "    pm.test('Llena c360_correo_admin en el entorno COMMUNITY 360 (valor local).', () => pm.expect.fail('Petición no enviada'));",
                  "    pm.execution.skipRequest();",
                  "}",
                  "pm.variables.set('c360_correo_json', JSON.stringify(correo));",
                  "pm.variables.set('c360_password_json', JSON.stringify('contraseña-inventada-000'));"
                ]
