        {
          "name": "13. Usuarios (página 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "const llaves = ['id_usuario', 'alias', 'fecha_ingreso', 'cod_rango_edad', 'cod_especie', 'cod_interes', 'cod_plataforma', 'es_artista', 'mensajes_30d', 'reacciones_30d', 'eventos_asistidos', 'comisiones_compradas', 'sentimiento_promedio', 'ultima_actividad', 'estatus', 'consentimiento_datos', 'es_atipico', 'ubicacion'];",
                  "function revisarUsuario(u) {",
                  "    pm.expect(u).to.have.all.keys(llaves);",
                  "    if (u.consentimiento_datos) {",
                  "        pm.expect(u.ubicacion, u.id_usuario).to.have.all.keys('pais', 'estado', 'ciudad', 'zona_horaria');",
                  "    } else {",
                  "        pm.expect(u.ubicacion, u.id_usuario).to.eql(null);",
                  "    }",
                  "}",
                  "pm.test('Nunca hay coordenadas', () => {",
                  "    pm.expect(pm.response.text()).to.not.include('latitud');",
                  "    pm.expect(pm.response.text()).to.not.include('longitud');",
                  "});",
                  "pm.test('Paginación del contrato', () => {",
                  "    pm.expect(r).to.have.all.keys('total', 'pagina', 'limite', 'datos');",
                  "    pm.expect(r.pagina).to.eql(1);",
                  "    pm.expect(r.limite).to.eql(50);",
