# Copia este archivo como .env y llena tus datos. NUNCA subas .env a GitHub ni lo pongas en el PDF.

# TiDB Cloud Starter (botón Connect del cluster)
TIDB_HOST=gateway01.xx-xxxx-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=xxxxxxxx.root
TIDB_PASSWORD=
TIDB_DB=community360

# Couchbase Capella (Connect + Cluster Access)
CB_CONN=couchbases://cb.xxxxxxxx.cloud.couchbase.com
CB_USER=
CB_PASSWORD=
CB_BUCKET=community360
CB_SCOPE=app
